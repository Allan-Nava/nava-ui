{
  "name": "@allan_nava/nava-ui",
  "version": "0.11.0",
  "description": "A small, dark-first UI kit in plain CSS",
  "license": "Apache-2.0",
  "author": "Allan Nava",
  "homepage": "https://allan-nava.github.io/nava-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allan-Nava/nava-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Allan-Nava/nava-ui/issues"
  },
  "keywords": [
    "css",
    "ui-kit",
    "design-tokens",
    "dark-mode",
    "components",
    "tailwind"
  ],
  "style": "dist/nava-ui.css",
  "exports": {
    ".": {
      "style": "./dist/nava-ui.css",
      "default": "./dist/nava-ui.css"
    },
    "./components.css": "./dist/nava-ui.components.css",
    "./motion.css": "./dist/nava-ui.motion.css",
    "./js": "./dist/nava-ui.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind-preset": "./dist/tailwind.preset.cjs",
    "./tokens.dark.json": "./dist/tokens.dark.json",
    "./tokens.light.json": "./dist/tokens.light.json",
    "./dist/*": "./dist/*",
    "./css/*": "./css/*",
    "./src/*": "./src/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/site",
    "!dist/tokens.site.scss",
    "css",
    "src",
    "fonts"
  ],
  "type": "module",
  "scripts": {
    "build": "./scripts/build.sh",
    "serve": "node scripts/serve.mjs 8000",
    "backlog": "npx --yes backlogsync check",
    "roadmap": "npx --yes backlogsync roadmap",
    "contrast": "node scripts/contrast.mjs",
    "render-assets": "node scripts/render-assets.mjs",
    "drift": "node scripts/site-drift.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "sass": "^1.108.2"
  },
  "workspaces": [
    "packages/react"
  ]
}
