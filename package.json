{
  "name": "nava-ui",
  "version": "0.2.0",
  "private": true,
  "description": "A small, dark-first UI kit in plain CSS",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "./scripts/build.sh",
    "serve": "node scripts/serve.mjs 8000",
    "backlog": "npx --yes backlogsync check",
    "roadmap": "npx --yes backlogsync roadmap",
    "contrast": "node scripts/contrast.mjs",
    "drift": "node scripts/site-drift.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.65.0"
  }
}
