{
  "name": "@allan_nava/nava-ui-react",
  "version": "0.11.0",
  "description": "Thin typed React wrappers over the nava-ui classes; the CSS stays the source of the look",
  "license": "Apache-2.0",
  "author": "Allan Nava",
  "homepage": "https://allan-nava.github.io/nava-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allan-Nava/nava-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Allan-Nava/nava-ui/issues"
  },
  "keywords": [
    "react",
    "nava-ui",
    "components",
    "ui-kit"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
